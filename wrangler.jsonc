{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pokemon-reading-challenge",
  "main": "pokemon-worker.js",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  }
}
